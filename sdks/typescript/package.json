{
  "name": "@oqtopus-team/qdash-sdk",
  "version": "0.0.0",
  "packageManager": "bun@1.4.0",
  "description": "TypeScript SDK for QDash calibrations and registered workflows, built on @oqtopus-team/qdash-client",
  "type": "module",
  "license": "Apache-2.0",
  "author": "OQTOPUS Team <oqtopus-team@googlegroups.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oqtopus-team/qdash.git",
    "directory": "sdks/typescript"
  },
  "homepage": "https://oqtopus-team.github.io/qdash/",
  "bugs": "https://github.com/oqtopus-team/qdash/issues",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --out-dir dist --external @oqtopus-team/qdash-client",
    "check": "tsc --noEmit && vitest run",
    "prepack": "bun run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@oqtopus-team/qdash-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
